{
  "name": "whisper",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm build:sdk && pnpm -r typecheck",
    "build:sdk": "pnpm --filter @whisper/sdk build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test && pnpm test:contracts",
    "test:contracts": "cd contracts && forge test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  }
}
